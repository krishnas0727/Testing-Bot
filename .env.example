# ============================================================
# DEX ARBITRAGE TERMINAL - 24/7 AUTOMATED HOSTING CONFIG
# ============================================================

# --- Blockchain Network (Base L2 Recommended for Sub-Cent Gas) ---
DEFAULT_CHAIN=base
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org
TRADING_SYMBOL=WETH/USDT

# --- 24/7 Autonomous Trading Switches ---
# Set TRADING_MODE to LIVE for real on-chain trades, or MOCK for risk-free simulation
TRADING_MODE=LIVE
AUTO_TRADE_ENABLED=true
LIVE_TRADING_ARMED=true
EMERGENCY_STOP=false

# --- Single Dedicated Bot Wallet (Required for 24/7 Server Autotrading) ---
# Create a NEW dedicated wallet (do NOT use your personal main wallet).
# Export its private key and enter both here.
WALLET_ADDRESS=
PRIVATE_KEY=
ARBITRAGE_CONTRACT_ADDRESS=0xf7A798D5E0A4CBB0f109cEC2B02f7f4bFB9c8f5a

# --- Trade Sizing & Risk Controls (in USDT / USDC) ---
DEFAULT_TRADE_AMOUNT=5.0
MIN_TRADE_AMOUNT=0.0001
MAX_TRADE_AMOUNT=500.0

# --- Profitability & Execution Safety Gates ---
MIN_PROFIT_USDT=0.005
MIN_PROFIT_PERCENT=0.005
SLIPPAGE_PCT=0.50
MAX_PRICE_IMPACT_PCT=1.00
MAX_GAS_PRICE_GWEI=50.0
ESTIMATED_GAS_UNITS=250000
MAX_DAILY_LOSS_USDT=10.00

# --- Engine Scanning Frequency & Latency Guard ---
AUTO_TRADE_COOLDOWN=2
REFRESH_INTERVAL=2
MAX_QUOTE_AGE_MS=5000
ON_CHAIN_STREAM_ENABLED=true

# --- Web Server Configuration ---
PORT=5000
HOST=0.0.0.0
DEBUG=false
