# ============================================================
# DEX ARBITRAGE & TREASURY SYSTEM — ENVIRONMENT CONFIGURATION
# ============================================================
# SAFETY MANDATE:
# 1. Never commit real private keys or secrets to version control.
# 2. In MOCK and TESTNET modes, keep TRADING_MODE=MOCK or TESTNET.
# 3. For live non-custodial trading, sign via MetaMask (leave PRIVATE_KEY empty).
# ============================================================

# --- Trading Mode & Safety Killswitches ---
TRADING_MODE=MOCK                      # MOCK | TESTNET | LIVE
AUTO_TRADE_ENABLED=false               # Autonomous background trading switch
LIVE_TRADING_ARMED=false               # Explicit safety arming required for live execution
EMERGENCY_STOP=false                   # Master circuit breaker (set true to freeze everything)

# --- Active Blockchain Network ---
CHAIN_ID=8453                          # 8453 (Base L2), 42161 (Arbitrum), 137 (Polygon), 11155111 (Sepolia)
DEFAULT_CHAIN=base

# --- Multi-Chain RPC Endpoints (Public or Private Archive Nodes) ---
RPC_URL=https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
POLYGON_RPC_URL=https://polygon-rpc.com
ETHEREUM_RPC_URL=https://cloudflare-eth.com

# --- Smart Contract Addresses ---
ARBITRAGE_CONTRACT_ADDRESS=            # Deployed ArbitrageExecutor.sol address
TREASURY_CONTRACT_ADDRESS=             # Deployed Treasury.sol address

# --- Non-Custodial Wallet / Optional Autonomous Signer ---
WALLET_ADDRESS=                        # Your public 0x... address
DEPLOYER_PRIVATE_KEY=                  # Only used for Hardhat testnet deployments (Leave empty)
PRIVATE_KEY=                           # Preferred secure source: server execution key (Leave empty for MetaMask non-custodial)

# --- Trade Sizing & Risk Controls ---
DEFAULT_TRADE_AMOUNT=10.0              # Default input notional (USDT / USDC)
MIN_TRADE_AMOUNT=0.10                  # Minimum trade size
MAX_TRADE_AMOUNT=500.0                 # Maximum trade size ceiling
MIN_PROFIT_USDT=0.01                   # Minimum net profit gate in USD
MIN_PROFIT_PERCENT=0.10                # Minimum profit ROI %
SLIPPAGE_PCT=0.50                      # Maximum slippage tolerance %
MAX_PRICE_IMPACT_PCT=1.00              # Maximum allowable price impact % (3.0% on testnet)
MAX_GAS_PRICE_GWEI=20.0                # Max gas price ceiling in Gwei
MAX_DAILY_LOSS_USDT=10.00              # Daily loss circuit breaker threshold
AUTO_TRADE_COOLDOWN=15                 # Cooldown seconds between executions

# --- Multi-Bucket Treasury Allocation Rules (Basis Points, 10000 = 100%) ---
TREASURY_TRADING_CAPITAL_BPS=6000      # 60% Compounding Trading Inventory
TREASURY_GAS_RESERVE_BPS=2000          # 20% Gas and Downside Buffer
TREASURY_PROFIT_RESERVE_BPS=2000       # 20% Founder & Staking Yield

# --- Block Explorer APIs (For Automated Contract Verification) ---
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
POLYGONSCAN_API_KEY=

# --- API Security Authentication ---
API_AUTH_TOKEN=your-strong-secret-token-here   # Bearer token required to protect sensitive API endpoints (never commit real token)

# --- Monitoring Dashboard Server ---
PORT=5000
HOST=127.0.0.1
DEBUG=false


# ============================================================
# LIVE TRADING QUICK-START (Base mainnet, server-side signing)
# Use a FRESH hot wallet holding only what you can afford to lose.
# ============================================================
# TRADING_MODE=LIVE
# CHAIN_ID=8453
# DEFAULT_CHAIN=base
# RPC_URL=https://mainnet.base.org                      # better: your own Alchemy/QuickNode/dRPC Base URL
# LIVE_EXEC_RPC_URL=https://mainnet-preconf.base.org    # Flashblocks: ~200 ms pre-confirmation (public = rate-limited)
# TRADING_SYMBOL=WETH/USDC
# PRIVATE_KEY=0x...                                     # never commit / never paste anywhere
# ARBITRAGE_CONTRACT_ADDRESS=0x...                      # from: python setup_live.py deploy
# DEFAULT_TRADE_AMOUNT=5
# MAX_TRADE_AMOUNT=10
# MAX_GAS_PRICE_GWEI=1
# LIVE_MIN_NET_PROFIT_USDT=0.02                         # required profit AFTER gas, enforced on-chain
# LIVE_TRADING_ARMED=false                              # flip to true only after dry-run looks right
# EMERGENCY_STOP=false
# AUTO_TRADE_ENABLED=false                              # keep false for the first trades (use manual /api/trade)
