# ============================================================
# DEX-ONLY ARBITRAGE TERMINAL CONFIGURATION
# ============================================================

# Network & Web3 RPC
RPC_URL=https://cloudflare-eth.com
CHAIN_ID=1
DEFAULT_CHAIN=ethereum

# Trading pair (ERC-20 token symbols)
TRADING_SYMBOL=WETH/USDT

# Safe defaults: MOCK mode with auto-trade disabled
TRADING_MODE=MOCK
AUTO_TRADE_ENABLED=false
LIVE_TRADING_ARMED=false
EMERGENCY_STOP=true

# Non-Custodial Wallet & Smart Contract Configuration
# Leave blank to use built-in Mock Wallet in MOCK mode
WALLET_ADDRESS=
PRIVATE_KEY=
ARBITRAGE_CONTRACT_ADDRESS=0xf7A798D5E0A4CBB0f109cEC2B02f7f4bFB9c8f5a

# Trade Sizing & Risk Controls (USDT)
DEFAULT_TRADE_AMOUNT=100
MIN_TRADE_AMOUNT=10
MAX_TRADE_AMOUNT=5000

# Profitability & Execution Gates
MIN_PROFIT_USDT=0.50
MIN_PROFIT_PERCENT=0.20
SLIPPAGE_PCT=0.50
MAX_PRICE_IMPACT_PCT=1.00
MAX_GAS_PRICE_GWEI=50.0
ESTIMATED_GAS_UNITS=250000

# Timing & Monitoring
AUTO_TRADE_COOLDOWN=15
REFRESH_INTERVAL=2
MAX_DAILY_LOSS_USDT=10.00
ON_CHAIN_STREAM_ENABLED=true

# Production Server
DEBUG=false
PORT=5000
HOST=0.0.0.0
