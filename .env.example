# ============================================================
# DEX ARBITRAGE & TREASURY SYSTEM — ENVIRONMENT CONFIGURATION
# ============================================================
# SAFETY MANDATE:
# 1. Never commit real private keys or secrets to version control.
# 2. In MOCK and TESTNET modes, keep TRADING_MODE=MOCK or TESTNET.
# 3. For live non-custodial trading, sign via MetaMask (leave PRIVATE_KEY empty).
# ============================================================

# --- Trading Mode & Safety Killswitches ---
# Default trading mode is MOCK. LIVE mode must be set explicitly by the operator.
# MOCK | TESTNET | LIVE
TRADING_MODE=MOCK
AUTO_TRADE_ENABLED=false               # Autonomous background trading switch
LIVE_TRADING_ARMED=false               # Explicit safety arming required for live execution
EMERGENCY_STOP=false                   # Master circuit breaker (set true to freeze everything)

# --- Active Blockchain Network ---
CHAIN_ID=42161                          # 42161 (Arbitrum One), 8453 (Base L2), 137 (Polygon), 11155111 (Sepolia)
DEFAULT_CHAIN=arbitrum

# --- Multi-Chain RPC Endpoints (Public or Private Archive Nodes) ---
RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org
POLYGON_RPC_URL=https://polygon-rpc.com
ETHEREUM_RPC_URL=https://cloudflare-eth.com

# --- Smart Contract Addresses ---
# Deployed ArbitrageExecutor.sol address (leave empty if not deployed)
ARBITRAGE_CONTRACT_ADDRESS=
# Deployed Treasury.sol address (leave empty if not deployed)
TREASURY_CONTRACT_ADDRESS=

# --- Non-Custodial Wallet / Optional Autonomous Signer ---
# Your public 0x... address
WALLET_ADDRESS=
# Only used for Hardhat testnet deployments (Leave empty)
DEPLOYER_PRIVATE_KEY=
# Preferred secure source: server execution key (Leave empty for MetaMask non-custodial)
PRIVATE_KEY=

# --- Trade Sizing & Risk Controls ---
DEFAULT_TRADE_AMOUNT=5.0               # Default input notional (USDT / USDC)
MIN_TRADE_AMOUNT=0.0001                # Minimum trade size (supports micro-trades down to 0.0001)
MAX_TRADE_AMOUNT=20.0                  # Maximum trade size ceiling
MIN_PROFIT_USDT=0.005                  # Minimum net profit gate in USD
MIN_PROFIT_PERCENT=0.005               # Minimum profit ROI %
SLIPPAGE_PCT=0.50                      # Maximum slippage tolerance %
MAX_PRICE_IMPACT_PCT=1.00              # Maximum allowable price impact % (3.0% on testnet)
MAX_GAS_PRICE_GWEI=50.0                # Max gas price ceiling in Gwei
MAX_DAILY_LOSS_USDT=10.00              # Daily loss circuit breaker threshold
AUTO_TRADE_COOLDOWN=15                 # Cooldown seconds between executions

# --- Multi-Bucket Treasury Allocation Rules (Basis Points, 10000 = 100%) ---
TREASURY_TRADING_CAPITAL_BPS=6000      # 60% Compounding Trading Inventory
TREASURY_GAS_RESERVE_BPS=2000          # 20% Gas and Downside Buffer
TREASURY_PROFIT_RESERVE_BPS=2000       # 20% Founder & Staking Yield

# --- Block Explorer APIs (For Automated Contract Verification) ---
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
POLYGONSCAN_API_KEY=

# --- API Security Authentication ---
# Bearer token required to protect sensitive API endpoints (never commit real token)
API_AUTH_TOKEN=

# --- Monitoring Dashboard Server ---
PORT=5000
HOST=127.0.0.1
DEBUG=false


# ============================================================
# LIVE TRADING QUICK-START (Arbitrum One mainnet, server-side signing)
# Use a FRESH hot wallet holding only what you can afford to lose.
# Never commit real private keys or paste anywhere.
# ============================================================
# TRADING_MODE=LIVE
# CHAIN_ID=42161
# DEFAULT_CHAIN=arbitrum
# RPC_URL=https://arb1.arbitrum.io/rpc
# TRADING_SYMBOL=WETH/USDT
# PRIVATE_KEY=
# ARBITRAGE_CONTRACT_ADDRESS=
# DEFAULT_TRADE_AMOUNT=5
# MAX_TRADE_AMOUNT=10
# MAX_GAS_PRICE_GWEI=1
# LIVE_MIN_NET_PROFIT_USDT=0.02
# LIVE_TRADING_ARMED=false
# EMERGENCY_STOP=false
# AUTO_TRADE_ENABLED=false
